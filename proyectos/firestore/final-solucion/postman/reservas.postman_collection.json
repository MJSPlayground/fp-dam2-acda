                  "pm.test(\"Listado completo disponible\",()=>pm.response.to.have.status(200));",
                  "const ids=pm.response.json().map(r=>r.id).sort();",
                  "pm.test(\"Al menos dos reservas para paginar\",()=>pm.expect(ids.length).to.be.at.least(2));",
                  "pm.collectionVariables.set(\"idsEsperados\",JSON.stringify(ids));"
                ]
              }
            }
          ]
        },
        {
          "name": "Primera página",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/reservas/pagina?limite=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "const p=pm.response.json(),ids=JSON.parse(pm.collectionVariables.get(\"idsEsperados\"));",
                  "pm.test(\"Primera página respeta límite y orden\",()=>{pm.expect(p.elementos).to.have.lengthOf(1);pm.expect(p.elementos[0].id).to.eql(ids[0]);pm.expect(p.siguienteCursor).to.eql(ids[0]);});",
                  "pm.collectionVariables.set(\"cursor\",p.siguienteCursor);",
                  "pm.collectionVariables.set(\"primeraPaginaId\",p.elementos[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Página siguiente",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/reservas/pagina?limite=1&cursor={{cursor}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "const p=pm.response.json(),ids=JSON.parse(pm.collectionVariables.get(\"idsEsperados\"));",
                  "pm.test(\"Segunda página continúa sin repetir\",()=>{pm.expect(p.elementos).to.have.lengthOf(1);pm.expect(p.elementos[0].id).to.eql(ids[1]);pm.expect(p.elementos[0].id).not.to.eql(pm.collectionVariables.get(\"primeraPaginaId\"));pm.expect(p.elementos[0].id > pm.collectionVariables.get(\"primeraPaginaId\")).to.be.true;pm.expect(p.siguienteCursor).to.eql(ids.length>2?ids[1]:null);});"
                ]
              }
            }
          ]
        },
        {
          "name": "Límite inválido400",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/reservas/pagina?limite=0"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\",()=>pm.response.to.have.status(400));",
                  "pm.test(\"Error estructurado\",()=>{const e=pm.response.json();pm.expect(e.estado).to.eql(pm.response.code);pm.expect(e.mensaje).to.be.a(\"string\");pm.expect(e.ruta).to.be.a(\"string\");});"
                ]
              }
            }
          ]
        },
        {
          "name": "Limpiar primera",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/reservas/{{primeraId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\",()=>pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Limpiar segunda",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/reservas/{{segundaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\",()=>pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
